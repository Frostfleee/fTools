{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "fTools",
  "version": "1.0.0",
  "identifier": "com.ftools.app",

  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "fTools",
        "width": 540,
        "height": 220,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": true,
        "transparent": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}